# Backend
APP_NAME=Portal de Chamados Engenharia API
APP_ENV=development
APP_DEBUG=true
API_PREFIX=
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/helpdesk_engenharia
SECRET_KEY=change-me-in-dev
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
SLA_MONITOR_LOOKBACK_DAYS=30
SLA_ALERT_REPEAT_HOURS=6

# CORS / Security
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
REPORT_EXPORT_MAX_ROWS=5000

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
